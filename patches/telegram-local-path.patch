+        root = tmp_path / "storage"
+        root.mkdir()
+        payload = b"x" * (32 * 1024 * 1024)
+        (root / "large.MOV").write_bytes(payload)
+        adapter.config.extra = {"local_path_prefixes": {"/var/lib/telegram-bot-api": str(root)}}
+        file_obj = _make_file_obj(b"wrong-http-fallback")
+        file_obj.file_path = "/var/lib/telegram-bot-api/large.MOV"
+        assert await adapter._download_telegram_file_bytes(file_obj) == payload
+        file_obj.download_as_bytearray.assert_not_awaited()
